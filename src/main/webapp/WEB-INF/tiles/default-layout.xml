<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
		"-//Apache Sofware Foundation//DTD Tiles Configuration 2.1//EN"
		"http://tiles.apache.org/dtds/tiles-config_2_1.dtd">
		
<tiles-definitions>
	<definition name="layout-tiles" template="/tilesLayout.jsp">
		<put-attribute name="header" value="/WEB-INF/jsp/egovframework/example/include/header.jsp" />
		<put-attribute name="sideBar" value="/WEB-INF/jsp/egovframework/example/include/sideBar.jsp" />
		<put-attribute name="body" value="" />
		<put-attribute name="footer" value="/WEB-INF/jsp/egovframework/example/include/footer.jsp" />
	</definition>
	
	<definition name="empty" template="/empty.jsp">
		<put-attribute name="header" value="/WEB-INF/jsp/egovframework/example/include/header.jsp" />
		<put-attribute name="body" value="" />
		<put-attribute name="footer" value="/WEB-INF/jsp/egovframework/example/include/footer.jsp" />
	</definition>
	
	<definition name="contest/main" extends="empty">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/contest/main.jsp"></put-attribute>
	</definition>
	<definition name="popup/*" extends="empty">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/popup/{1}.jsp"></put-attribute>
	</definition>
	
	<definition name="*" extends="layout-tiles">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/{1}.jsp" />
	</definition>
	<definition name="*/*" extends="layout-tiles">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/{1}/{2}.jsp" />
	</definition>
	<definition name="*/*/*" extends="layout-tiles">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/{1}/{2}/{3}.jsp" />
	</definition>
	<definition name="*/*/*/*" extends="layout-tiles">
		<put-attribute name="body" value="/WEB-INF/jsp/egovframework/example/{1}/{2}/{3}/{4}.jsp" />
	</definition>
	
</tiles-definitions>